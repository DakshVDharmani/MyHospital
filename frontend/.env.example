# Express backend used for the protected admin session.
VITE_API_URL=http://localhost:8787

# After publishing from Power BI Desktop, use File > Embed report > Website or portal
# and paste the URL from the iframe's src attribute here.
VITE_POWER_BI_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=YOUR_REPORT_ID&groupId=YOUR_WORKSPACE_ID
