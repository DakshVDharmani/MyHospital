{
  "name": "myhospital-voice-server",
  "version": "1.0.0",
  "description": "Multilingual voice assistant backend (Sarvam AI TTS/STT + chat). Kept fully separate from the React frontend.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
