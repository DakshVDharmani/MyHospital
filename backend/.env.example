# ============================================================
#  MyHospital voice assistant — backend configuration
#  ============================================================
#  Copy this file to `.env` and fill in your own keys.
#  Free Sarvam AI key: https://dashboard.sarvam.ai (sign up → API Keys → Create Key)
#  Free Groq key:      https://console.groq.com/keys
# ============================================================

# ---- Sarvam AI (chat + text-to-speech) ----
SARVAM_API_KEY=

# ---- Groq (speech-to-text) ----
GROQ_API_KEY=

# ---- Server ----
PORT=8787

# ---- Free-tier daily budget (requests per ip per day) ----
FREE_DAILY_LIMIT=25

# ---- Default assistant language (hi | ta | te | bn | ml | kn | mr | gu | en) ----
DEFAULT_LANG=hi

# ---- Sarvam model overrides (optional — sane defaults are used if unset) ----
# SARVAM_TTS_MODEL=bulbul:v2     # or bulbul:v3 for the newer 30+ voice catalog
# SARVAM_STT_MODEL=saaras:v3     # or saaras:v4 (latest)
# SARVAM_CHAT_MODEL=sarvam-105b
# GROQ_STT_MODEL=whisper-large-v3-turbo
