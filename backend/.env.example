# ============ MyHospital backend ============
# Copy to `.env` and fill in. Never commit the real .env.

# ---- Server ----
PORT=8787
# Comma-separated allow-list of frontend origins in production.
# Leave as * for local dev.
CORS_ORIGIN=*

# ---- MongoDB (appointments API) ----
# MongoDB Atlas connection string — Cluster → Connect → Drivers.
# If unset, /api/appointments is disabled but the server still boots.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=myhospital

# ---- Supabase (validates the caller's login) ----
# The backend calls GET {SUPABASE_URL}/auth/v1/user to verify the bearer token,
# so no JWT secret is needed — both values below are public.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- Voice assistant (Sarvam AI + Groq) ----
SARVAM_API_KEY=
GROQ_API_KEY=
FREE_DAILY_LIMIT=25
DEFAULT_LANG=hi
